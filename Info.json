    "network-request",
    "file-system"
  ],
  "allowedDomains": [
    "subhd.tv",
    "www.subhd.tv",
    "subhd.me",
    "www.subhd.me",
    "subhdtw.com",
    "www.subhdtw.com",
    "subhd.one",
    "www.subhd.one",
    "subhd.top",
    "www.subhd.top",
    "subhd.cc",
    "www.subhd.cc",
    "dl.subhd.tv",
    "dl.subhd.me",
    "dl.subhdtw.com",
    "dl.subhd.one",
    "dl.subhd.top",
    "dl.subhd.cc"
  ],
  "subtitleProviders": [
    {
      "id": "subhd-cn",
      "name": "SubHD 中文字幕"
    }
  ],
  "preferencesPage": "preferences.html",
  "preferenceDefaults": {
    "baseURL": "https://subhd.tv",
    "fallbackBaseURL": "https://subhd.me"
  },
  "ghRepo": "Andy-GHJ/iina-subhd",
  "ghVersion": 3
